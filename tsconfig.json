{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "outDir": "js",
    "rootDir": "src",
    "strict": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noEmitHelpers": true,
    "useDefineForClassFields": false,
    "removeComments": true
  },
  "include": ["src/atelier-crm.ts"]
}
